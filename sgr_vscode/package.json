{
    "name": "sgr-agent-client",
    "displayName": "SGR Agent Client",
    "description": "Connects your editor to your personal SGR Agent (BYOA).",
    "version": "0.1.0",
    "publisher": "macht",
    "repository": {
        "type": "git",
        "url": "https://github.com/macht/sgr_vscode"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "AI",
        "Productivity"
    ],
    "activationEvents": [
        "onView:sgr.chatView"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "sgr-sidebar",
                    "title": "SGR Agent",
                    "icon": "media/sgr_icon.svg"
                }
            ]
        },
        "views": {
            "sgr-sidebar": [
                {
                    "type": "webview",
                    "id": "sgr.chatView",
                    "name": "SGR Chat"
                }
            ]
        },
        "commands": [
            {
                "command": "sgr.ask",
                "title": "Ask SGR Agent"
            }
        ],
        "keybindings": [
            {
                "command": "sgr.ask",
                "key": "ctrl+shift+a",
                "mac": "cmd+shift+a",
                "when": "editorTextFocus"
            }
        ],
        "configuration": {
            "title": "SGR Agent",
            "properties": {
                "sgr.serverUrl": {
                    "type": "string",
                    "default": "http://localhost:8000/v1/agent/process",
                    "description": "URL of your running SGR Core Server"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "@types/node": "^20.2.5",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^5.59.8",
        "@typescript-eslint/parser": "^5.59.8",
        "@vscode/test-electron": "^2.3.2",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "typescript": "^5.1.3"
    },
    "dependencies": {
        "@types/highlight.js": "^9.12.4",
        "@types/markdown-it": "^14.1.2",
        "highlight.js": "^11.11.1",
        "markdown-it": "^14.1.0"
    }
}