# --- IDE и Операционная система ---
# .gitignore
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Python (Общее для cbr_rag, personal_assistant, sgr_core) ---
__pycache__/
*.py[cod]
*$py.class
# Файлы с переменными окружения (тут хранятся API ключи)
.env
.env.local
venv/
.venv/
env/

# --- Project: bcs_manager (Android) ---
bcs_manager/.gradle/
bcs_manager/build/
bcs_manager/app/build/
# В этом файле часто лежит путь к SDK и иногда ключи подписи
bcs_manager/local.properties
bcs_manager/captures/
bcs_manager/.externalNativeBuild/
*.apk

# --- Project: sgr_vscode (Node.js / TypeScript) ---
sgr_vscode/node_modules/
sgr_vscode/out/
sgr_vscode/*.vsix
sgr_vscode/.vscode-test/
npm-debug.log
yarn-error.log

# --- Project: sgr_core (AI Agent & RAG) ---
# Логи работы агента
sgr_core/logs/
# Локальная база данных векторов (может быть большой)
sgr_core/qdrant_data/
# Сгенерированные файлы и временные данные
sgr_core/generated_files/
sgr_core/.files/

# If the refs folder contains private documents for RAG, uncomment the line below:
# sgr_core/refs/

# --- SECRETS & KEYS (STRICT) ---
*.env
*.env.*
!.env.example
*.json
!google-services.json
!package.json
!tsconfig.json
!app/src/test/resources/*.json
*.xml
!AndroidManifest.xml
!res/**/*.xml
!checkstyle.xml
!pom.xml
!nav_graph.xml
!*styles.xml
!*strings.xml
!*colors.xml
!*dimens.xml
!*themes.xml
!*attrs.xml
!*backup_rules.xml
!*data_extraction_rules.xml
!*network_security_config.xml
!idea/**/workspace.xml
*.jks
*.keystore
*.pem
*.p12
*.key
*.ovpn
*.ppk
*.ssh
id_rsa
id_dsa
*.pem
secrets.yaml
secrets.yml
.gitignore

# --- LOGS & DATABASES ---
*.log
*.sqlite
*.db
*.db-journal
sgr_core/memory.db
sgr_core/qdrant_data/
sgr_core/proxy_data/
sgr_core/generated_files/

# --- GARBAGE & CACHE ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.bak
*.class
*.jar
*.war
*.ear
*.hprof
.gradle/
build/
local.properties
.idea/
.vscode/
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
requests.http

# --- SPECIFIC FILES TO IGNORE ---
bcs_manager/rename_package.py
bcs_manager/app/AppNavGraph.kt
bcs_manager/app/Screen.kt
