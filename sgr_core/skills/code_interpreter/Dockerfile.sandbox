# Lightweight Python sandbox
FROM python:3.11-slim

# Install common data science libs pre-baked to save time
RUN pip install --no-cache-dir pandas numpy matplotlib scipy networkx

# Create a non-root user
RUN useradd -m -u 1000 sanduser
USER sanduser
WORKDIR /home/sanduser

# Command to keep container alive (we will exec into it)
CMD ["tail", "-f", "/dev/null"]
