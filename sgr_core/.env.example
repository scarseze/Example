# DeepSeek API Settings
# Get key here: https://platform.deepseek.com/ Use Proxy if needed.
DEEPSEEK_API_KEY=sk-your-key-here

# Max Messenger Config 🇷🇺
MAX_BOT_TOKEN=
MAX_API_URL=https://api.max.ru/bot/v1

# Telegram Config
TELEGRAM_TOKEN=
GROQ_API_KEY=gsk_...

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=sgr_docs

# Ollama Embeddings (Local)
# Use host.docker.internal to access Ollama on host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Proxy Configuration (Internal Docker Network)
PROXY_URL=http://sgr_proxy:8000
PYTHONUNBUFFERED=1

# Chainlit Settings
CHAINLIT_PORT=8501
